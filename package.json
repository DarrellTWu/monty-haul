{
  "name": "monty-haul",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "server": "node --env-file=server/.env server/index.js",
    "start": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run dev\"",
    "start:prod": "node server/index.js",
    "test": "node shared/tests/combat.test.js",
    "test:all": "node scripts/run-tests.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
